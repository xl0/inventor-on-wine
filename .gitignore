# Allowlist: big/binary/third-party/secret stuff stays out (VM disks, prefixes,
# Autodesk installers, wine-src (own repo), builds, vm/id_ed25519).
/*
!/.gitignore
!/.vscode/
!/CODE.md
!/README.md
!/PLAN.md
!/issues/
!/notes/
!/tools/
!/x/
!/tests/
!/vm/
!/vmwl/
!/deps/
/deps/*
!/deps/dxvk.sh
/vm/*
!/vm/autounattend.xml
!/vm/setup.ps1
!/vm/run.sh
!/vm/shot.sh
!/vm/input.py
!/vm/winrun.sh
/vmwl/*
!/vmwl/README.md
!/vmwl/run.sh
!/vmwl/fetch.sh
!/vmwl/ssh.sh
!/vmwl/shot.sh
!/vmwl/input.py
!/vmwl/session.sh
!/vmwl/wl.sh
!/vmwl/probes.sh
!/vmwl/provision.sh
!/vmwl/provision2.sh
!/vmwl/user-data.in
!/vmwl/globals-*.txt
!/vmwl/shots/
!/vmwl/results-134.md
!/vmwl/results/
!/vmwl/wl_xowner.sh
/vmwl/results/*
!/vmwl/results/*.txt
*.log
*.log.old
*.exe
*.res
*.tgz
/x/xorg*.out
/x/xorg-[0-9]*.conf
/tests/sxs_probe/cases/
/x/leases
/x/leases.lock
