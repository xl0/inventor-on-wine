#cloud-config
# User xl0/uid 1000 = host user (Wine's Windows user name is the Unix user name).
users:
  - name: xl0
    uid: 1000
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys: [ "@PUBKEY@" ]
mounts:
  - [ host, /host, virtiofs, "ro,nofail", "0", "0" ]
ssh_pwauth: false
