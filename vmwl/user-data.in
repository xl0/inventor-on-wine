#cloud-config
# User xl0/uid 1000 = host user (Wine's Windows user name is the Unix user name).
users:
  - name: xl0
    uid: 1000
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys: [ "@PUBKEY@" ]
mounts:
  - [ host, /host, virtiofs, "ro,nofail", "0", "0" ]
ssh_pwauth: false
write_files:
  # Autodesk licensing: guest 127.0.0.1:39683 -> host loopback (qemu slirp 10.0.2.2). Must be up before any Wine
  # process of the Inventor prefix, or its own licensing service binds the port and becomes a second device.
  - path: /etc/systemd/system/adsk-lic-fwd.socket
    content: |
      [Socket]
      ListenStream=127.0.0.1:39683
      [Install]
      WantedBy=sockets.target
  - path: /etc/systemd/system/adsk-lic-fwd.service
    content: |
      [Service]
      ExecStart=/usr/lib/systemd/systemd-socket-proxyd 10.0.2.2:39683
runcmd:
  - [ systemctl, enable, --now, adsk-lic-fwd.socket ]
