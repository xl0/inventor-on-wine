+static struct { Display *display; unsigned long thread; } _X191_owner[256];
+static void _X191_set_owner(Display *display)
+{
+    unsigned int i = ((unsigned long)display >> 4) & 255, n;
+    for (n = 0; n < 256; n++, i = (i + 1) & 255) {
+	if (_X191_owner[i].display == display || !_X191_owner[i].display) {
+	    _X191_owner[i].thread = (unsigned long)pthread_self();
+	    _X191_owner[i].display = display;
+	    return;
+	}
+    }
