@@ -53,6 +53,14 @@
 
 #include "unixlib.h"
 
+/* DEBUG 157: lock order checks */
+extern void dbg_lock_acquired(void *lock, const char *name);
+extern void dbg_lock_released(void *lock);
+static inline int dbg_mutex_lock(pthread_mutex_t *m, const char *name) { int r = pthread_mutex_lock(m); dbg_lock_acquired(m, name); return r; }
+static inline int dbg_mutex_unlock(pthread_mutex_t *m) { dbg_lock_released(m); return pthread_mutex_unlock(m); }
+#define pthread_mutex_lock(m) dbg_mutex_lock(m, #m)
+#define pthread_mutex_unlock(m) dbg_mutex_unlock(m)
+
 /* We only use 4 byte formats. */
 #define WINEWAYLAND_BYTES_PER_PIXEL 4
 
diff --git a/dlls/winewayland.drv/waylanddrv_main.c b/dlls/winewayland.drv/waylanddrv_main.c
index 275a3907f92..03ae44e8ab7 100644
--- a/dlls/winewayland.drv/waylanddrv_main.c
+++ b/dlls/winewayland.drv/waylanddrv_main.c
@@ -32,6 +32,75 @@
 
 char *process_name = NULL;
 
+/* DEBUG 157: lock order checks */
+#undef pthread_mutex_lock
+#undef pthread_mutex_unlock
+#include <execinfo.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+static __thread struct { void *lock; const char *name; } dbg_held[32];
+static __thread int dbg_held_count;
+static pthread_mutex_t dbg_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct { const char *a, *b; void *pc[6]; } dbg_pairs[1024];
+static int dbg_pair_count;
+
+static void dbg_record(const char *a, const char *b)
+{
+    void *bt[24];
+    int i, n = backtrace(bt, ARRAY_SIZE(bt));
+    void *pc[6] = {0};
+
+    for (i = 0; i < 6 && i + 2 < n; i++) pc[i] = bt[i + 2];
+    pthread_mutex_lock(&dbg_mutex);
+    for (i = 0; i < dbg_pair_count; i++)
+        if (dbg_pairs[i].a == a && dbg_pairs[i].b == b && !memcmp(dbg_pairs[i].pc, pc, sizeof(pc))) break;
+    if (i == dbg_pair_count && dbg_pair_count < ARRAY_SIZE(dbg_pairs))
+    {
+        dbg_pairs[i].a = a; dbg_pairs[i].b = b; memcpy(dbg_pairs[i].pc, pc, sizeof(pc));
+        dbg_pair_count++;
+        fprintf(stderr, "LOCKORDER %s pid %d tid %ld: %s -> %s\n", process_name ? process_name : "?", getpid(), syscall(SYS_gettid), a, b);
+        fflush(stderr);
+        backtrace_symbols_fd(bt + 2, n - 2, 2);
+        fprintf(stderr, "LOCKORDER end\n");
+        fflush(stderr);
+    }
+    pthread_mutex_unlock(&dbg_mutex);
+}
+
+void dbg_lock_acquired(void *lock, const char *name)
+{
+    int i;
+    for (i = 0; i < dbg_held_count; i++) if (dbg_held[i].lock == lock) break;
+    if (i == dbg_held_count) /* not a recursive acquisition */
+        for (i = 0; i < dbg_held_count; i++) dbg_record(dbg_held[i].name, name);
+    if (dbg_held_count < ARRAY_SIZE(dbg_held))
+    {
+        dbg_held[dbg_held_count].lock = lock;
+        dbg_held[dbg_held_count].name = name;
+    }
+    dbg_held_count++;
+}
+
+void dbg_lock_released(void *lock)
+{
+    int i;
+    for (i = min(dbg_held_count, (int)ARRAY_SIZE(dbg_held)) - 1; i >= 0; i--) if (dbg_held[i].lock == lock) break;
+    if (i < 0) { fprintf(stderr, "LOCKORDER bad release %p\n", lock); return; }
+    memmove(&dbg_held[i], &dbg_held[i + 1], (min(dbg_held_count, (int)ARRAY_SIZE(dbg_held)) - i - 1) * sizeof(dbg_held[0]));
+    dbg_held_count--;
+}
+
+static void dbg_win32u_lock(const char *name)
+{
+    static const char *names[] = {"user", "display", "client_surfaces", "window_surfaces_list", "window_surface"};
+    static const char *full[] = {"win32u:user", "win32u:display", "win32u:client_surfaces", "win32u:window_surfaces_list", "win32u:window_surface"};
+    int i, j;
+    for (j = 0; j < ARRAY_SIZE(names); j++) if (!strcmp(names[j], name)) break;
+    for (i = 0; i < dbg_held_count && i < ARRAY_SIZE(dbg_held); i++) dbg_record(dbg_held[i].name, full[j]);
+}
+
 static const struct user_driver_funcs waylanddrv_funcs =
 {
     .pClipboardWindowProc = WAYLAND_ClipboardWindowProc,
@@ -92,6 +161,7 @@ static NTSTATUS waylanddrv_unix_init(void *arg)
     /* Set the user driver functions now so that they are available during
      * our initialization. We clear them on error. */
     __wine_set_user_driver(&waylanddrv_funcs, WINE_GDI_DRIVER_VERSION);
+    win32u_lock_hook = dbg_win32u_lock;
 
     wayland_init_process_name();
 
