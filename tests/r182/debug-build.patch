+/* DEBUG 173: lock order checks */
+#include <execinfo.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+static __thread struct { void *lock; const char *name; int flags; } dbg_held[64];
+static __thread int dbg_held_count;
+static pthread_mutex_t dbg_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct { const char *a, *b; void *pc[6]; } dbg_pairs[8192];
+static int dbg_pair_count;
+
+static const char *dbg_name( const char *name ) { const char *p = strrchr( name, '/' ); return p ? p + 1 : name; }
+
+static void dbg_record( const char *a, int a_flags, const char *b, int b_flags )
+{
+    void *bt[28];
+    int i, n = backtrace( bt, ARRAY_SIZE(bt) );
+    void *pc[6] = {0};
+
+    /* pairs with a driver lock: one report per call chain; win32u's own pairs: one per pair */
+    if ((a_flags | b_flags) & 2) for (i = 0; i < 6 && i + 2 < n; i++) pc[i] = bt[i + 2];
+    (pthread_mutex_lock)( &dbg_mutex );
+    for (i = 0; i < dbg_pair_count; i++)
+        if (!strcmp( dbg_pairs[i].a, a ) && !strcmp( dbg_pairs[i].b, b ) && !memcmp( dbg_pairs[i].pc, pc, sizeof(pc) )) break;
+    if (i == dbg_pair_count && dbg_pair_count < ARRAY_SIZE(dbg_pairs))
+    {
+        dbg_pairs[i].a = a; dbg_pairs[i].b = b; memcpy( dbg_pairs[i].pc, pc, sizeof(pc) );
+        dbg_pair_count++;
+        fprintf( stderr, "LOCKORDER pid %d tid %ld: %s%s -> %s%s%s\n", getpid(), syscall( SYS_gettid ),
+                 (a_flags & 2) ? "x11:" : "win32u:", dbg_name( a ), (b_flags & 2) ? "x11:" : "win32u:", dbg_name( b ),
+                 (b_flags & 1) ? " (try)" : "" );
+        fflush( stderr );
+        backtrace_symbols_fd( bt + 2, n - 2, 2 );
+        fprintf( stderr, "LOCKORDER end\n" );
+        fflush( stderr );
+    }
+    (pthread_mutex_unlock)( &dbg_mutex );
+}
+
+void dbg_lock_acquired( void *lock, const char *name, int flags )
+{
+    int i, count = min( dbg_held_count, (int)ARRAY_SIZE(dbg_held) );
+
+    for (i = 0; i < count; i++) if (dbg_held[i].lock == lock) break;
+    if (i == count) /* not a recursive acquisition */
+        for (i = 0; i < count; i++) dbg_record( dbg_held[i].name, dbg_held[i].flags, name, flags );
+    if (dbg_held_count < ARRAY_SIZE(dbg_held))
+    {
+        dbg_held[dbg_held_count].lock = lock;
+        dbg_held[dbg_held_count].name = name;
+        dbg_held[dbg_held_count].flags = flags;
+    }
+    dbg_held_count++;
+}
+
+void dbg_lock_released( void *lock )
+{
+    int i, count = min( dbg_held_count, (int)ARRAY_SIZE(dbg_held) );
+
+    for (i = count - 1; i >= 0; i--) if (dbg_held[i].lock == lock) break;
+    if (i < 0) { fprintf( stderr, "LOCKORDER bad release %p\n", lock ); return; }
+    memmove( &dbg_held[i], &dbg_held[i + 1], (count - i - 1) * sizeof(dbg_held[0]) );
+    dbg_held_count--;
+}
+
 void user_lock(void)
 {
     pthread_mutex_lock( &user_mutex );
