+/* DEBUG 182: who allocates X resource ids, on which display, with the display locked by this thread or not */
+__thread int dbg_xid_depth;
+static XID (*dbg_orig_alloc)( Display * );
+static pthread_mutex_t dbg_xid_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct { void *pc[20]; int kind, locked; unsigned long count; } dbg_sites[4096];
+static int dbg_site_count;
+static unsigned long dbg_counts[3][2];
+static const char * const dbg_kinds[] = { "gdi_display", "own thread display", "other thread's display" };
+
+/* one write() per block: several processes share the log */
+static void dbg_xid_block( const char *tag, const char *head, void **pc, int count )
+{
+    char buf[8192], **syms = backtrace_symbols( pc, count );
+    int i, len = snprintf( buf, sizeof(buf), "%s pid %d tid %ld: %s\n", tag, getpid(), syscall( SYS_gettid ), head );
+
+    for (i = 0; syms && i < count && pc[i] && len < sizeof(buf) - 300; i++) len += snprintf( buf + len, 256, "%s\n", syms[i] );
+    len += snprintf( buf + len, 32, "%s end\n", tag );
+    fflush( stderr );
+    write( 2, buf, len );
+    free( syms );
+}
+
+static void dbg_xid_dump(void)
+{
+    char head[256];
+    int i;
+
+    for (i = 0; i < dbg_site_count; i++)
+    {
+        snprintf( head, sizeof(head), "%lu allocations on %s, display lock %s", dbg_sites[i].count,
+                  dbg_kinds[dbg_sites[i].kind], dbg_sites[i].locked ? "held" : "NOT HELD" );
+        dbg_xid_block( "XIDSITE", head, dbg_sites[i].pc, 20 );
+    }
+    snprintf( head, sizeof(head), "gdi_display locked %lu unlocked %lu; own thread display locked %lu unlocked %lu; "
+              "other thread's display locked %lu unlocked %lu; sites %d", dbg_counts[0][1], dbg_counts[0][0],
+              dbg_counts[1][1], dbg_counts[1][0], dbg_counts[2][1], dbg_counts[2][0], dbg_site_count );
+    dbg_xid_block( "XIDSTAT", head, NULL, 0 );
+}
+
+static XID dbg_alloc_xid( Display *display )
+{
+    struct x11drv_thread_data *data = x11drv_thread_data();
+    int kind = display == gdi_display ? 0 : (data && data->display == display) ? 1 : 2;
+    int i, n, locked = dbg_xid_depth > 0;
+    void *bt[22], *pc[20] = {0};
+
+    n = backtrace( bt, 22 );
+    for (i = 1; i < n && i <= 20; i++) pc[i - 1] = bt[i];
+    (pthread_mutex_lock)( &dbg_xid_mutex );
+    dbg_counts[kind][locked]++;
+    for (i = 0; i < dbg_site_count; i++)
+        if (dbg_sites[i].kind == kind && dbg_sites[i].locked == locked && !memcmp( dbg_sites[i].pc, pc, sizeof(pc) )) break;
+    if (i == dbg_site_count && dbg_site_count < ARRAY_SIZE(dbg_sites))
+    {
+        memcpy( dbg_sites[i].pc, pc, sizeof(pc) );
+        dbg_sites[i].kind = kind;
+        dbg_sites[i].locked = locked;
+        dbg_site_count++;
+        if (!locked && kind != 1)
+        {
+            char head[128];
+            snprintf( head, sizeof(head), "resource id allocated on %s without the display lock", dbg_kinds[kind] );
+            dbg_xid_block( "XIDALLOC", head, bt + 1, n - 1 );
+        }
+    }
+    if (i < ARRAY_SIZE(dbg_sites)) dbg_sites[i].count++;
+    (pthread_mutex_unlock)( &dbg_xid_mutex );
+    return dbg_orig_alloc( display );
+}
+
+static void dbg_hook_display( Display *display )
+{
+    if (!dbg_orig_alloc) { dbg_orig_alloc = ((_XPrivDisplay)display)->resource_alloc; atexit( dbg_xid_dump ); }
+    ((_XPrivDisplay)display)->resource_alloc = dbg_alloc_xid;
+}
