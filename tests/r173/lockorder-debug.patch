+/* DEBUG 173: lock order checks */
+W32KAPI extern void dbg_lock_acquired( void *lock, const char *name, int flags ); /* flags: 1 = trylock, 2 = driver lock */
+W32KAPI extern void dbg_lock_released( void *lock );
+static inline int dbg_mutex_lock( pthread_mutex_t *m, const char *name, int flags )
+{ int r = pthread_mutex_lock( m ); dbg_lock_acquired( m, name, flags ); return r; }
+static inline int dbg_mutex_trylock( pthread_mutex_t *m, const char *name, int flags )
+{ int r = pthread_mutex_trylock( m ); if (!r) dbg_lock_acquired( m, name, flags | 1 ); return r; }
+static inline int dbg_mutex_unlock( pthread_mutex_t *m ) { dbg_lock_released( m ); return pthread_mutex_unlock( m ); }
+#ifdef DBG_LOCK_FLAGS
+#define pthread_mutex_lock(m) dbg_mutex_lock( m, __FILE__ ":" #m, DBG_LOCK_FLAGS )
+#define pthread_mutex_trylock(m) dbg_mutex_trylock( m, __FILE__ ":" #m, DBG_LOCK_FLAGS )
+#define pthread_mutex_unlock(m) dbg_mutex_unlock( m )
+#endif
+
 #endif /* __WINE_WINE_GDI_DRIVER_H */
