#!/usr/bin/env bash
# rm -rf for workers: tools/del [-rf] PATH...   (call it by absolute path from anywhere)
# Exists because Claude Code stops for a confirmation on raw `rm` (globs, paths outside the project,
# inside sh -c) even in bypass mode, which stalls background workers. Globs are fine: the shell
# expands them and every resulting path is checked. Anything below the project, /tmp, /var/tmp or
# /dev/shm may go, except what can't be recreated or is shared; the whole call is refused if one
# path isn't allowed.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
ROOTS=("$ROOT" /tmp /var/tmp /dev/shm)
# sign-in state, VM disks and keys, credentials, sources, shared and frozen builds, baselines
PROTECTED=(prefixes vm vmwl login.txt .git .gitignore .claude wine-src build deps iso x tools issues notes
	PLAN.md CODE.md README.md wt/lic wt/lic-build wt/regress-master wt/regress-master-build wt/wayland-inc)
ok=()
for a in "$@"; do
	case $a in -*) continue;; esac   # rm flags: always -rf
	case $(basename -- "$a") in .|..) echo "del: refused: $a" >&2; exit 1;; esac
	p=$(realpath -m -- "$(dirname -- "$a")")/$(basename -- "$a")   # the path itself may be a symlink: remove the link
	allowed=
	for r in "${ROOTS[@]}"; do case $p in "$r"/?*) allowed=1;; esac; done
	[ -n "$allowed" ] || { echo "del: refused, not below the project or a temp dir: $a -> $p" >&2; exit 1; }
	for x in "${PROTECTED[@]}"; do
		case $p in "$ROOT/$x"|"$ROOT/$x"/*) echo "del: refused, protected: $p" >&2; exit 1;; esac
		case $x in "${p#$ROOT/}"/*) echo "del: refused, contains protected $x: $p" >&2; exit 1;; esac
	done
	if [ -e "$p/.git" ]; then echo "del: refused, a git worktree (use git worktree remove): $p" >&2; exit 1; fi
	ok+=("$p")
done
[ ${#ok[@]} -gt 0 ] || exit 0
rm -rf -- "${ok[@]}"
