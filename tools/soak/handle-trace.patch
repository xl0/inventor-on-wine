+/* DEBUG 086: proxy manager refcount history with a raw stack scan */
+static void leak_pm( const char *what, void *pm, LONG refs )
+{
+    ULONG_PTR *sp = __builtin_frame_address(0), *top = NtCurrentTeb()->Tib.StackBase;
+    ULONG_PTR *bottom = NtCurrentTeb()->DeallocationStack;
+    char buf[1024], *p = buf;
+    int i, n = 0;
+
+    if (!TRACE_ON(leak)) return;
+    p += sprintf( p, "%s %p %ld", what, pm, refs );
+    for (i = 0; i < 256 && sp + i < top && n < 40; i++)
+        if (sp[i] >> 32 && sp[i] >> 47 == 0 && (sp[i] < (ULONG_PTR)bottom || sp[i] >= (ULONG_PTR)top)) { p += sprintf( p, " %Ix", sp[i] ); n++; }
+    TRACE_(leak)( "%s\n", buf );
+}
 
