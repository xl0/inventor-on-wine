+/* DEBUG 086: creation backtrace of unnamed handles: unwind through static image tables only
+ * (dynamic function table callbacks may take app locks) */
+static void leak_bt( const char *what, HANDLE h, const OBJECT_ATTRIBUTES *attr )
+{
+#ifdef __x86_64__
+    char buf[1024], *p = buf;
+    CONTEXT ctx;
+    int i;
+
+    static int inv = -1;
+
+    if (!TRACE_ON(leak) || !h || (attr->ObjectName && attr->ObjectName->Length)) return;
+    if (inv < 0) inv = !!wcsstr( NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer, L"Inventor.exe" );
+    if (!inv) return;
+    p += sprintf( p, "%s %04lx", what, HandleToULong(h) );
+    RtlCaptureContext( &ctx );
+    for (i = 0; i < 40; i++)
+    {
+        RUNTIME_FUNCTION *tab, *func = NULL;
+        ULONG_PTR base, frame;
+        ULONG len, lo = 0, hi;
+        void *data;
+
+        if (!(tab = RtlLookupFunctionTable( ctx.Rip, &base, &len ))) break;
+        hi = len / sizeof(*tab);
+        while (lo < hi)
+        {
+            ULONG mid = (lo + hi) / 2;
+            if (ctx.Rip - base < tab[mid].BeginAddress) hi = mid;
+            else if (ctx.Rip - base >= tab[mid].EndAddress) lo = mid + 1;
+            else { func = &tab[mid]; break; }
+        }
+        if (func) RtlVirtualUnwind( UNW_FLAG_NHANDLER, base, ctx.Rip, func, &ctx, &data, &frame, NULL );
+        else { ctx.Rip = *(ULONG64 *)ctx.Rsp; ctx.Rsp += 8; }
+        if (!ctx.Rip) break;
+        p += sprintf( p, " %Ix", (ULONG_PTR)ctx.Rip );
+    }
+    TRACE_(leak)( "%s\n", buf );
+#endif
+}
 
